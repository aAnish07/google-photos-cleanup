# --- Jev / TypeSafe classifier ---
TYPESAFE_API_KEY=your_jev_api_key

# --- Google OAuth (Web application client) ---
# credentials.json from Google Cloud goes in backend/auth/credentials.json.
# These are only needed if you prefer env-based client config instead.
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret

# --- App config ---
# Where OAuth sends the user back after consent. Must match the redirect URI
# registered on the OAuth client in Google Cloud.
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# Comma-separated extra origins allowed by CORS (frontend dev server is included by default)
# FRONTEND_ORIGIN=http://localhost:5173
